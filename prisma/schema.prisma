// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wedding {
  id            String   @id @default(cuid())
  slug          String   @unique
  groomName     String
  brideName     String
  weddingDate   String
  weddingTime   String
  venueName     String
  venueAddress  String   @default("")
  googleMapsLink String  @default("")
  welcomeMessage String  @default("")
  contactPhone  String   @default("")
  coverImage    String   @default("")
  coverCategory String   @default("")
  couplePhoto   String   @default("")
  galleryImages String   @default("[]")
  backgroundMusicUrl String @default("")
  clientPassword String  @default("")
  theme         String   @default("classic-gold")
  colorPreset   String   @default("")
  primaryColor   String  @default("#D4A853")
  secondaryColor String  @default("#1A1A2E")
  backgroundColor String @default("#0D0D1A")
  textColor      String  @default("#FFFFFF")
  buttonColor    String  @default("#D4A853")
  accentColor    String  @default("#E8C874")
  enableRsvp     Boolean  @default(true)
  enableGallery  Boolean  @default(true)
  enableCountdown Boolean @default(true)
  enableMusic    Boolean  @default(true)
  enableGuestPersonalization Boolean @default(true)
  isActive       Boolean  @default(true)

  // Customizable text fields with defaults
  bismallahText       String  @default("بسم الله الرحمن الرحيم")
  invitationTitle     String  @default("")
  heroSubtitle        String  @default("بقلوب يملؤها الشوق، بيتشرفوا بدعوتكم لمشاركتنا أجمل ليلة في العمر")
  heroSubSubtitle     String  @default("ليلة هنلتقي فيها على مائدة الحب، والله يجمعنا على خير وبركة")
  detailsTitle        String  @default("تفاصيل ليلة العمر")
  detailsSubtitle     String  @default("بشوق ننتظر حضوركم لنشارك معاً فرحة ليلة العمر")
  venueTitle          String  @default("حيث تُحتفل الفرحة")
  rsvpTitle           String  @default("هنيتشرفوا بحضوركم ليلة العمر؟")
  rsvpAttendingText   String  @default("يتشرفني الحضور بكل سرور")
  rsvpNotAttendingText String @default("أعتذر، وأتمنى لكم أجمل ليلة")
  cardInvitationText  String  @default("بيتشرفوا بدعوتكم لحضور حفل زفافهم")
  guestWelcomeText    String  @default("فرحتنا مش بتتكمل غير بوجودكم معانا")
  guestSubWelcomeText String  @default("بوجودكم تزدان ليلتنا وتكتمل فرحتنا")
  visitCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guests    Guest[]
  rsvps     RsvpResponse[]
}

model Guest {
  id        String   @id @default(cuid())
  weddingId String
  name      String
  phone     String   @default("")
  guestLink String   @default("")
  createdAt DateTime @default(now())

  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvp      RsvpResponse?
}

model RsvpResponse {
  id        String   @id @default(cuid())
  weddingId String
  guestId   String   @unique
  status    String   @default("pending")
  message   String   @default("")
  createdAt DateTime @default(now())

  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  type        String   @default("text") // text, image, audio
  name        String
  rating      Int      @default(5) // 1-5 stars
  text        String   @default("") // review text content
  imageUrl    String   @default("") // screenshot image URL (for image type)
  audioUrl    String   @default("") // audio file URL (for audio type)
  weddingName String   @default("") // optional: which wedding this review is about
  isActive    Boolean  @default(true)
  order       Int      @default(0) // display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
